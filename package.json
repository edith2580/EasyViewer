{
  "name": "easy-viewer",
  "private": true,
  "version": "0.2.0",
  "description": "심플한 Text, EPUB 범용 문서 뷰어 (Vue3 + TypeScript + Tauri 2 + epub.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:perf": "node scripts/run-perf-gate.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "check:commit-msg": "node scripts/check-commit-msg.mjs",
    "verify": "node scripts/verify.mjs",
    "tauri": "tauri",
    "android:init": "node scripts/android.mjs init --ci",
    "android:dev": "node scripts/android.mjs dev",
    "android:build": "node scripts/android.mjs build --apk --debug --target aarch64",
    "android:build:all": "node scripts/android.mjs build --apk --debug",
    "android:release": "node scripts/android.mjs build --apk --target aarch64",
    "android:release:all": "node scripts/android.mjs build --apk",
    "mac:dev": "tauri dev",
    "mac:build": "tauri build --target universal-apple-darwin",
    "mac:build:arm": "tauri build --target aarch64-apple-darwin",
    "mac:build:intel": "tauri build --target x86_64-apple-darwin",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "ios:install": "xcrun devicectl device install app --device 00008120-001A44101E38C01E src-tauri/gen/apple/build/easy-viewer_iOS.xcarchive/Products/Applications/EasyViewer.app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "tauri-plugin-keyring-store-api": "^0.3.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
