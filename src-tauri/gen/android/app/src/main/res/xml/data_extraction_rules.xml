<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup rules. android:allowBackup="false" covers older versions; on 12+
  it no longer stops device-to-device transfer, so everything is excluded here explicitly.
  App data holds the library, reading positions, WebView storage and approved-host/certificate
  decisions, which should not be copied off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
