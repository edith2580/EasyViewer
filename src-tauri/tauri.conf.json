{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyViewer",
  "version": "0.1.4",
  "identifier": "com.edith.easyviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasyViewer",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "GMXNVH8YU9"
    }
  }
}
